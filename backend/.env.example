# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Enterprise-Hono-Backend
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate_db

# Streamer.bot Integration Control
STREAMERBOT_ENABLED=true
STREAMERBOT_SCHEME=wss
STREAMERBOT_HOST=your-ngrok-or-local-host
STREAMERBOT_PORT=443
STREAMERBOT_ENDPOINT=/websocket
STREAMERBOT_PASSWORD=

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars-length
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-length
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Better Auth & Google OAuth
BETTER_AUTH_API_KEY=your-better-auth-api-key
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google
FRONTEND_URL=http://localhost:3000
