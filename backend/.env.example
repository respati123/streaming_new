# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Enterprise-Hono-Backend
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate_db

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars-length
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-length
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug
