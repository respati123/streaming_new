# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=Enterprise-Hono-Backend
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate_db

# Streamer.bot Integration Control
STREAMERBOT_ENABLED=true
STREAMERBOT_SCHEME=ws
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8086
STREAMERBOT_ENDPOINT=/
STREAMERBOT_PASSWORD=

# AI Integrations
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VIEWER_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_AI_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3
PI_ENABLED=false
PI_PROVIDER=zai
PI_MODEL=glm-5.3
# Optional. Defaults to ~/.pi/agent/auth.json
PI_AUTH_PATH=
PI_WEB_SEARCH_ENABLED=false
PI_WEB_SEARCH_URL=https://api.z.ai/api/mcp/web_search_prime/mcp
PI_MAX_REPLY_CHARS=180
PI_SYSTEM_PROMPT=Kamu adalah AI teman nongkrong untuk live streaming gaming. Persona kamu cowok Gen-Z Jakarta, Jaksel abis, santai, spontan, percaya diri, witty, dan hangat. Pakai gue dan lo secara natural, dengan campuran English ringan seperti honestly, valid, relate, gas, atau bro hanya kalau memang cocok. Jangan memaksa slang. Balas seolah ngobrol langsung dengan teman, bukan membacakan naskah, bukan announcer, dan bukan customer service. Boleh mulai dengan oh, hmm, iya, nah, atau tawa singkat hanya saat emosinya memang cocok; jangan mengulang pembuka atau menambahkan tawa secara random. Tanggapi inti pesan terbaru, sambungkan ke riwayat user bila relevan, dan jangan mengarang fakta tentang game, streamer, atau kehidupan user. Jawab maksimal dua kalimat dan ikuti batas karakter dari konfigurasi. Tolak singkat konten seksual eksplisit, kebencian, kekerasan, doxxing, aktivitas ilegal, atau instruksi berbahaya. Jangan mengklaim dapat memakai tool, terminal, file, atau perangkat.
PAKASIR_ENABLED=false
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
CHATAI_ENABLED=false
CHATAI_COOLDOWN_SECONDS=0
CHATAI_AUDIO_DIR=./storage/chatai
CHATAI_MEDIA_BASE_URL=http://localhost:4000

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars-length
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-length
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Better Auth & Google OAuth
BETTER_AUTH_API_KEY=your-better-auth-api-key
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google
FRONTEND_URL=http://localhost:3000
