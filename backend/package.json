{
  "name": "enterprise-hono-bun-boilerplate",
  "version": "1.0.0",
  "description": "Enterprise Backend Boilerplate using Bun, Hono, Drizzle ORM, PostgreSQL, and Structured Logging",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/core/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/core/database/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@hono/zod-validator": "^0.4.2",
    "@scalar/hono-api-reference": "^0.11.16",
    "@streamerbot/client": "^2.0.1",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.16",
    "jose": "^6.2.10",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.2"
  }
}
