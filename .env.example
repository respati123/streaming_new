# ==============================================================================
# Unified Docker & Environment Variables Configuration
# Copy this file to .env before starting Docker containers:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=boilerplate_db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=4000
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars-length-dev
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars-length-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=80
VITE_API_BASE_URL=http://localhost:4000/api/v1
